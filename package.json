{
	"name": "@nlib/cleanup-package-json",
	"publishConfig": {
		"access": "public"
	},
	"version": "0.5.0",
	"license": "Apache-2.0",
	"author": {
		"name": "Kei Ito",
		"email": "kei.itof@gmail.com",
		"url": "https://gojabako.zone"
	},
	"homepage": "https://github.com/nlibjs/cleanup-package-json",
	"repository": "https://github.com/nlibjs/cleanup-package-json",
	"engines": {
		"node": ">=22.20.0"
	},
	"type": "module",
	"main": "./esm/cli.mjs",
	"files": [
		"esm",
		"!**/*.test.*"
	],
	"bin": {
		"cleanup-package-json": "./esm/cli.mjs",
		"nlib-cleanup-package-json": "./esm/cli.mjs"
	},
	"scripts": {
		"build": "tsc",
		"test": "npm run build && npm run test:unit",
		"test:unit": "ava",
		"test:coverage": "c8 --reporter=text --reporter=lcov npm test",
		"lint": "biome check",
		"version": "npx @nlib/changelog --output CHANGELOG.md && git add CHANGELOG.md"
	},
	"dependencies": {
		"commander": "15.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.2",
		"@nlib/changelog": "0.4.2",
		"@types/node": "22.20.5",
		"ava": "8.1.1",
		"c8": "12.0.0",
		"typescript": "7.0.2"
	},
	"ava": {
		"files": [
			"esm/**/*.test.*(m|c)+(j|t)s*(x)"
		]
	},
	"renovate": {
		"extends": [
			"github>nlibjs/renovate-config"
		],
		"packageRules": [
			{
				"matchPackageNames": [
					"@types/node"
				],
				"allowedVersions": ">=22 <23"
			}
		]
	}
}
