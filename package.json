{
  "name": "@nlib/cleanup-package-json",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.4.0",
  "license": "Apache-2.0",
  "author": {
    "name": "Kei Ito",
    "email": "kei.itof@gmail.com",
    "url": "https://gojabako.zone"
  },
  "homepage": "https://github.com/nlibjs/cleanup-package-json",
  "repository": "https://github.com/nlibjs/cleanup-package-json",
  "engines": {
    "node": ">=22.20.0"
  },
  "type": "module",
  "main": "./esm/cli.mjs",
  "files": [
    "esm",
    "!**/*.test.*"
  ],
  "bin": {
    "cleanup-package-json": "./lib/cli.mjs",
    "nlib-cleanup-package-json": "./lib/cli.mjs"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && npm run test:unit",
    "test:unit": "ava",
    "test:coverage": "c8 --reporter=text --reporter=lcov npm test",
    "lint": "eslint src",
    "format:check": "prettier --check .",
    "version": "npx @nlib/changelog --output CHANGELOG.md && git add CHANGELOG.md"
  },
  "dependencies": {
    "commander": "15.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nlib/changelog": "0.3.2",
    "@types/node": "22.20.5",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "ava": "8.0.1",
    "c8": "12.0.0",
    "eslint": "10.12.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "prettier": "3.9.7",
    "typescript": "5.9.3"
  },
  "ava": {
    "files": [
      "esm/**/*.test.*(m|c)+(j|t)s*(x)"
    ]
  },
  "renovate": {
    "extends": [
      "github>nlibjs/renovate-config"
    ],
    "packageRules": [
      {
        "matchPackageNames": [
          "@types/node"
        ],
        "allowedVersions": ">=22 <23"
      },
      {
        "matchPackageNames": [
          "@typescript-eslint/eslint-plugin",
          "@typescript-eslint/parser"
        ],
        "groupName": "typescript-eslint"
      },
      {
        "matchPackageNames": [
          "@eslint/js",
          "eslint"
        ],
        "groupName": "eslint"
      }
    ]
  }
}
